<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_usuarios" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Definição dos campos -->
    <field name="nome" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Relatório de Usuários]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <!-- Mudança de "Cliente" para "Usuário" e de "Pedido" para "E-mail" -->
            <staticText><reportElement x="60" y="0" width="150" height="20"/><text><![CDATA[Usuário]]></text></staticText>
            <staticText><reportElement x="0" y="0" width="50" height="20"/><text><![CDATA[E-mail]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <!-- Preenchimento dos campos com os dados de 'usuario' e 'email' -->
            <textField><reportElement x="60" y="0" width="150" height="20"/><textFieldExpression><![CDATA[$F{nome}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="0" width="50" height="20"/><textFieldExpression><![CDATA[$F{email}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
